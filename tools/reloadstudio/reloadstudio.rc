// Version resource for Reload Studio.
//
// For the same reason as tools/rldpack.rc (see its header): a tool
// that is handed to strangers should say what it is called, where it comes from
// and which version it is. A code signature is still missing.
//
// The strings FileVersion/ProductVersion say "Beta 0" like the game
// (CTR_NATIVE_VERSION in CMakeLists.txt, kept in step here by hand). The
// build ID is in the window title, not here.

#include <winver.h>

#define RELOADSTUDIO_VERSION_MAJOR 0
#define RELOADSTUDIO_VERSION_MINOR 1
#define RELOADSTUDIO_VERSION_PATCH 0
#define RELOADSTUDIO_VERSION_BUILD 0

VS_VERSION_INFO VERSIONINFO
FILEVERSION    RELOADSTUDIO_VERSION_MAJOR, RELOADSTUDIO_VERSION_MINOR, RELOADSTUDIO_VERSION_PATCH, RELOADSTUDIO_VERSION_BUILD
PRODUCTVERSION RELOADSTUDIO_VERSION_MAJOR, RELOADSTUDIO_VERSION_MINOR, RELOADSTUDIO_VERSION_PATCH, RELOADSTUDIO_VERSION_BUILD
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",      "CTR Reload"
			VALUE "FileDescription",  "Reload Studio - track containers and cups"
			VALUE "FileVersion",      "Beta 0"
			VALUE "InternalName",     "ReloadStudio"
			VALUE "LegalCopyright",   "CTR Reload"
			VALUE "OriginalFilename", "ReloadStudio.exe"
			VALUE "ProductName",      "CTR Reload"
			VALUE "ProductVersion",   "Beta 0"
			VALUE "Comments",         "Builds .rldtrack containers with rldpack (format 4.1), edits cups.txt, tests tracks in the game."
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		// 0x0409 = English (USA), 0x04b0 = Unicode - the front end is English.
		VALUE "Translation", 0x0409, 0x04b0
	END
END
